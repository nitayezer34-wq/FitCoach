<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitCoach">

        <activity
            android:name=".screens.RecipeForumActivity"
            android:exported="false" />
        <activity
            android:name=".screens.AddRecipeActivity"
            android:exported="false" />
        <activity
            android:name=".screens.RecipeDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".screens.AdminActivity"
            android:exported="false" />
        <activity
            android:name=".screens.UsersListActivity"
            android:exported="false" />
        <activity
            android:name=".screens.UserProfileActivity"
            android:exported="false" />

        <activity
            android:name=".screens.WorkoutActivity"
            android:exported="false" />
        <activity
            android:name=".screens.UserWorkoutsActivity"
            android:exported="false" />
        <activity
            android:name=".screens.WorkoutCreationActivity"
            android:exported="false" />
        <activity
            android:name=".screens.WorkoutChecklistActivity"
            android:exported="false" />
        <activity
            android:name=".screens.AdminWorkoutManagementActivity"
            android:exported="false" />
        <activity
            android:name=".screens.AdminRecipeManagementActivity"
            android:exported="false" />

        <activity
            android:name=".screens.MainActivity"
            android:exported="false" />
        <activity
            android:name=".screens.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".screens.RegisterActivity"
            android:exported="false"
            android:label="@string/title_activity_register" />

        <activity
            android:name=".screens.LandingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".HealthConnectPermissionsRationaleActivity"
            android:exported="true"
            android:targetActivity=".screens.MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
