<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:layoutDirection="rtl">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnSaveRecipe"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="הוספת מתכון חדש"
                android:textColor="#2196F3"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- Card for Basic Details -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="פרטי המתכון"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#2196F3"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etRecipeTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="שם המתכון"
                        android:backgroundTint="#2196F3"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etImageUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="כתובת URL של התמונה"
                        android:backgroundTint="#2196F3"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etPrepTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="זמן הכנה (דקות)"
                            android:inputType="number"
                            android:backgroundTint="#2196F3"
                            android:layout_marginEnd="8dp"/>

                        <EditText
                            android:id="@+id/etCalories"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="סה״כ קלוריות"
                            android:inputType="number"
                            android:backgroundTint="#2196F3"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card for Ingredients -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="מצרכים"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#2196F3"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etIngredients"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="כל מצרך בשורה חדשה..."
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:gravity="top"
                        android:backgroundTint="#2196F3"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card for Instructions -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="אופן ההכנה"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#2196F3"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etInstructions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="כל שלב בשורה חדשה..."
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:gravity="top"
                        android:backgroundTint="#2196F3"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card for Allergens -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                     <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="מידע נוסף"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#2196F3"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etAllergens"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="אלרגנים (מופרדים בפסיק)"
                        android:backgroundTint="#2196F3"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnSaveRecipe"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:text="הוסף מתכון"
        android:backgroundTint="#2196F3"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="18sp"
        app:cornerRadius="15dp"/>

</RelativeLayout>