<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F5"
    android:layoutDirection="rtl">

    <TextView
        android:id="@+id/tv_workout_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="האימון המותאם שלך"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        android:layout_marginBottom="5dp"/>

    <TextView
        android:id="@+id/tv_workout_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="בהתאם לנתוני ה-BMI שלך"
        android:textSize="16sp"
        android:layout_marginBottom="20dp"/>

    ;<ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/ll_exercise_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btn_finish_workout"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="סיום אימון וחזרה"
        android:backgroundTint="#2196F3"
        android:textColor="@android:color/white"
        android:layout_marginTop="10dp"/>
</LinearLayout>
