<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:layoutDirection="rtl">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btn_save_profile"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="עריכת פרופיל"
                android:textColor="#2196F3"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- Personal Details Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="פרטים אישיים"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#2196F3"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/et_user_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="שם מלא"
                        android:backgroundTint="#2196F3"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/et_user_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="אימייל"
                        android:enabled="false"
                        android:backgroundTint="#BDBDBD"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/et_user_height"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="גובה (ס״מ)"
                            android:inputType="number"
                            android:backgroundTint="#2196F3"
                            android:layout_marginEnd="8dp"/>

                        <EditText
                            android:id="@+id/et_user_weight"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="משקל (ק״ג)"
                            android:inputType="numberDecimal"
                            android:backgroundTint="#2196F3"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Daily Goals Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                     <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="יעדים יומיים"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#2196F3"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/et_daily_steps_target"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="יעד צעדים יומי"
                        android:inputType="number"
                        android:backgroundTint="#2196F3"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/et_daily_calories_target"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="יעד קלוריות יומי"
                        android:inputType="number"
                        android:backgroundTint="#2196F3"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/et_daily_water_target"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="יעד מים יומי (מ״ל)"
                        android:inputType="number"
                        android:backgroundTint="#2196F3"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_save_profile"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:text="שמור שינויים"
        android:backgroundTint="#2196F3"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="18sp"
        app:cornerRadius="15dp"/>

</RelativeLayout>