<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="160dp"
    android:viewportWidth="120"
    android:viewportHeight="160">

    <!-- Inner jug shape for liquid - Matches the new ic_water_jug.xml -->
    <path android:pathData="M35,31 L85,31 C90,31 94,36 94,41 L99,134 C99,144 89,149 84,149 L36,149 C31,149 21,144 21,134 L26,41 C26,36 31,31 35,31 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="60"
                android:endY="30"
                android:startX="60"
                android:startY="150"
                android:type="linear">
                <item
                    android:color="#1565C0"
                    android:offset="0" />
                <item
                    android:color="#1E88E5"
                    android:offset="0.5" />
                <item
                    android:color="#4FC3F7"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Moving wave reflection effect at the top -->
    <path
        android:pathData="M25,45 Q60,35 95,45"
        android:strokeWidth="2.5"
        android:strokeColor="#60FFFFFF"
        android:strokeLineCap="round" />

    <!-- Deep water shadow at the bottom -->
    <path
        android:pathData="M35,145 H85"
        android:strokeWidth="8"
        android:strokeColor="#10000000" />

</vector>