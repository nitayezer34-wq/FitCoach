<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="160dp"
    android:viewportWidth="120"
    android:viewportHeight="160">

    <!-- The Jug Glass Body - Stronger Outline and more visible glass tint -->
    <path
        android:pathData="M35,30 L85,30 C90,30 95,35 95,40 L100,135 C100,145 90,150 85,150 L35,150 C30,150 20,145 20,135 L25,40 C25,35 30,30 35,30 Z"
        android:strokeWidth="2.5">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startY="30"
                android:startX="60"
                android:endY="150"
                android:endX="60"
                android:type="linear">
                <item android:offset="0" android:color="#152196F3" />
                <item android:offset="1" android:color="#302196F3" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startY="30"
                android:startX="60"
                android:endY="150"
                android:endX="60"
                android:type="linear">
                <item android:offset="0" android:color="#B0BEC5" />
                <item android:offset="0.5" android:color="#2196F3" />
                <item android:offset="1" android:color="#1976D2" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylish Handle - Darker and thicker -->
    <path
        android:pathData="M95,55 C115,55 115,125 98,130"
        android:strokeWidth="6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startY="55"
                android:startX="105"
                android:endY="130"
                android:endX="105"
                android:type="linear">
                <item android:offset="0" android:color="#2196F3" />
                <item android:offset="1" android:color="#1976D2" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Spout Detail - Refined and smaller to look more elegant -->
    <path
        android:pathData="M35,30 L20,30 C16,30 16,38 22,42 L25,44"
        android:strokeWidth="2.2"
        android:strokeColor="#1976D2"
        android:strokeLineCap="round"
        android:fillColor="#202196F3" />

    <!-- Lid (Top) - Enlarged and taller -->
    <path
        android:pathData="M32,18 L88,18 C93,18 95,23 95,30 L25,30 C25,23 27,18 32,18 Z"
        android:fillColor="#FFFFFF"
        android:strokeColor="#1976D2"
        android:strokeWidth="1.8" />

    <!-- Top Knob - Adjusted position for the larger lid -->
    <path
        android:pathData="M55,12 L65,12 C67,12 68,15 68,18 L52,18 C52,15 53,12 55,12 Z"
        android:fillColor="#2196F3"
        android:strokeColor="#1976D2"
        android:strokeWidth="1.2" />

    <!-- Sharp Reflections to give it "pop" -->
    <path
        android:pathData="M35,45 L32,140"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startY="45"
                android:startX="35"
                android:endY="140"
                android:endX="32"
                android:type="linear">
                <item android:offset="0" android:color="#F0FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M45,40 L43,80"
        android:strokeWidth="2"
        android:strokeColor="#A0FFFFFF"
        android:strokeLineCap="round" />

</vector>