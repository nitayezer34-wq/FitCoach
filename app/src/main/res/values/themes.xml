<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.FitCoach" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main colors -->
        <item name="colorPrimary">@color/fit_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/fit_accent</item>
        <item name="colorOnSecondary">@color/fit_primary</item>

        <!-- DatePicker colors -->
        <item name="android:datePickerDialogTheme">@style/FitDatePickerTheme</item>
    </style>

    <style name="Theme.FitCoach" parent="Base.Theme.FitCoach" />

    <!-- עיצוב היומן - תיקון כפתורים נעלמים -->
    <style name="FitDatePickerTheme" parent="Theme.Material3.Light.Dialog">
        <!-- צבע הכותרת והבחירה -->
        <item name="colorPrimary">@color/fit_primary</item>
        <item name="colorAccent">@color/fit_primary</item>

        <!-- צבע הטקסט ביומן (שיהיה שחור/כחול כהה ולא לבן) -->
        <item name="android:textColorPrimary">#000000</item>

        <!-- הגדרת צבע הכפתורים (אישור/ביטול) שיהיו כחולים ובולטים -->
        <item name="buttonBarPositiveButtonStyle">@style/FitDatePickerButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/FitDatePickerButtonStyle</item>
    </style>

    <style name="FitDatePickerButtonStyle" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#1976D2</item> <!-- כחול כהה בולט -->
        <item name="android:textStyle">bold</item>
    </style>
</resources>